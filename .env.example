# Copy to .env.local for local work; set the same names as secrets/env vars when deploying.
ANTHROPIC_API_KEY=
# Bare project URL, https://<ref>.supabase.co (no /rest/v1/)
SUPABASE_URL=
# Server-only. Bypasses RLS, so never expose it to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=
# Optional model overrides
# DIGEST_TRANSLATE_MODEL=claude-haiku-5-5
# DIGEST_SUMMARY_MODEL=claude-sonnet-5-5
# Password for /admin, where hand-curated posts are added. Leave empty to disable the admin login.
ADMIN_PASSWORD=
# Optional: model for the /admin AI draft (default claude-opus-5-5)
# DIGEST_DRAFT_MODEL=claude-opus-5-5
